# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Django core ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
# Comma-separated. Add your deployed host in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Third-party APIs ---
# https://api.setlist.fm/docs/1.0/index.html  (free, requires an account)
SETLISTFM_API_KEY=your-setlistfm-api-key-here
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Database ---
# Optional. If unset, Django falls back to a local SQLite file (db.sqlite3).
# Example (Neon / any Postgres):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- CORS ---
# Comma-separated origins allowed to call the API (the frontend dev server, plus
# your deployed frontend URL in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173
